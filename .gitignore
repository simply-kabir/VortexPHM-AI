# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Node & Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
next-env.d.ts

# Raw and processed data (large). Only the compact demo fleet is committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
*.h5
*.hdf5
*.parquet
!data/serving/*.parquet

# Trained artifacts: backend/artifacts/ IS committed (small, needed for deployment).
# Ignore only scratch model dumps elsewhere.
models/*.onnx
models/*.pt
notebooks/**/checkpoints/

# Generated evidence (figures can be large; commit results/*.json if you want them versioned)
results/figures/

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local environment and databases (keep .env.example)
.env
.env.*
!.env.example
*.sqlite3
*.db
