# ---------------- VortexPHM-AI backend (copy to .env, never commit .env) ----------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Project root override (set to /srv inside the Docker image)
# VORTEX_ROOT=

# Audit log database. Use ONE of the two:
#   SQLite file (needs a persistent disk on hosted platforms)
AUDIT_DB=./backend/audit.db
#   or a managed PostgreSQL instance (takes precedence when set)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/vortex

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ---------------- Model / decision parameters (see Canonical_Parameters.md) ----------------
TARGET_FAR=0.01                      # threshold calibration target (persistent-alarm, cycle-level)
PERSIST_K=3
PERSIST_N=5
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60 # below this an anomaly is flagged UNCERTAIN_ANOMALY
XAI_TOP_K_SENSORS=3
RUL_REF_CYCLES=125
TIER1_MIN_URGENCY=70
TIER2_MIN_URGENCY=40

# Assumption-based cost model (replace with figures you can justify)
COST_UER_USD=450000
COST_INSPECTION_USD=15000
DEFER_HORIZON_CYCLES=30

# ---------------- Frontend (put these in frontend/.env.local, not here) ----------------
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
